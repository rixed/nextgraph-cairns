PREFIX app: <did:ng:z:cairns/>
PREFIX schema: <https://schema.org/>
PREFIX xsd: <http://www.w3.org/2001/XMLSchema#>
PREFIX foaf: <http://xmlns.com/foaf/0.1/>
PREFIX geo: <http://www.w3.org/2003/01/geo/wgs84_pos#>
PREFIX dcterms: <http://purl.org/dc/terms/>

# EXTRA a: memories are multi-typed — always schema:Event (§3), sometimes
# schema:Trip (§3.6). The shape keys on app:Memory and tolerates the rest.
app:MemoryShape EXTRA a {
  a [app:Memory] ;
  schema:name xsd:string ? ;
  schema:startDate xsd:dateTime OR xsd:date OR xsd:gYearMonth OR xsd:gYear ;
  schema:endDate xsd:dateTime OR xsd:date OR xsd:gYearMonth OR xsd:gYear ? ;
  schema:text xsd:string ? ;
  schema:description xsd:string ? ;
  # Locations and attendees are held as plain references, never as nested
  # objects — spike 7. A union-typed property only reports what the ORM itself
  # wrote, and this app writes through SPARQL to keep date datatypes (spike 2),
  # so a union would leave the app unable to read back its own writes. An
  # unnamed location (§3.2) is therefore a subject inside the memory's own
  # document rather than an anonymous object, and both kinds are resolved by
  # joining to app:PlaceShape on the IRI.
  schema:location IRI * ;
  # 0..N, as §3.3 always said: the old 0..1 was a codegen limit, not a decision.
  schema:attendee IRI * ;
  dcterms:subject IRI * ;
  # Media the user attached explicitly (§3.4). References to foreign documents:
  # the app writes the link, never the media.
  schema:subjectOf IRI * ;
  # Cover: one of this memory's media, designated locally.
  schema:image IRI ? ;
  # Per-media notes. The app cannot write to a foreign media document, so a
  # note about a photograph lives on the memory that references it (§3.4).
  schema:comment @app:MediaNoteShape * ;
}

# A note the user wrote about one media: nested, no URI of its own.
app:MediaNoteShape EXTRA a {
  a [schema:Comment] ;
  schema:about IRI ;
  schema:text xsd:string ;
}

# Places live in placeShape.shex: they are read across the whole store, not
# through the memory, so they are a shape of their own (§5). People will be the
# same when S-61 arrives; until something reads them, no shape is declared.
